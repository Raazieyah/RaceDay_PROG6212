    <UserSecretsId>85cf95e2-6281-4b45-8159-3aedb12e065a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
