
@*//reference vieworganiser- models*@
@model List<RaceDay.Mvc.Models.EventDto>

<h1>My Events</h1>
<a asp-action="CreateEvent" class="btn btn-success mb-3">Create Event</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Distance (km)</th>
            <th>Date</th>
            <th>Location</th>
            <th>Manage</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Name</td>
                <td>@ev.EventType</td>
                <td>@ev.DistanceKm</td>
                <td>@ev.EventDate.ToString("yyyy-MM-dd")</td>
                <td>@ev.Location</td>
                <td>
                    <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Categories" asp-route-eventId="@ev.Id" class="btn btn-sm btn-info">Categories</a>
                    <a asp-action="Enrolments" asp-route-eventId="@ev.Id" class="btn btn-sm btn-primary">Enrolments</a>
                </td>
            </tr>
        }
    </tbody>
</table>

