@model RaceDay.Mvc.Models.EventDetailsVm

@if (!string.IsNullOrWhiteSpace(Model.Event.BannerImageUrl))
{
    <div class="mb-3">
        <img src="@Model.Event.BannerImageUrl" alt="@Model.Event.Name event banner" class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
    </div>
}

<h1>@Model.Event.Name</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        
        <p><strong>Date:</strong> @Model.Event.EventDate.ToString("yyyy-MM-dd")</p>
        <p><strong>Location:</strong> @Model.Event.Location</p>
        <p><strong>Distance:</strong> @Model.Event.DistanceKm km</p>
        <p>@Model.Event.Description</p>
    </div>
</div>

<h3>Enter Event</h3>

@if (!Model.Categories.Any())
{
    <div class="alert alert-warning">No categories are available for this event yet.</div>
}
else
{
    <form asp-action="EnterEvent" method="post">
        <input type="hidden" name="eventId" value="@Model.Event.Id" />

        <div class="mb-3">
            <label for="categoryId" class="form-label">Select Category</label>
            <select id="categoryId" name="categoryId" class="form-select" required>
                <option value="">-- Choose a category --</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id">@cat.Name (@cat.Description)</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-success">Enter Event</button>
        <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
    </form>
}


    
